{
  "schema": "trader20.haraldr-coding-exec-policy.v1",
  "phase": "A04-offline",
  "tool": "coding_exec",
  "checkout_root": "/workspace",
  "workdir_policy": "checkout-relative-existing-directory-no-traversal-no-symlink-escape",
  "commands": {
    "allow": ["go_test", "go_build", "go_vet"],
    "deny": [
      "shell", "package_install", "service_management", "container_management",
      "raw_network_client", "credential_access", "host_path_access"
    ]
  },
  "network": {
    "external_egress": false,
    "compose_network": "haraldr-code-runner-internal",
    "internal_only": true
  },
  "credentials": {
    "mounted": false,
    "environment_inheritance": false
  },
  "limits": {
    "timeout_seconds_default": 60,
    "timeout_seconds_max": 120,
    "output_bytes_default": 65536,
    "request_bytes_max": 131072,
    "memory": "512m",
    "cpus": "0.50",
    "pids": 64
  },
  "container": {
    "user": "65532:65532",
    "read_only_root": true,
    "no_new_privileges": true,
    "capabilities": [],
    "shared_mounts": ["haraldr-goclaw-workspace:/workspace:rw"],
    "forbidden_mounts": [
      "/var/run/docker.sock", "/run/containerd/containerd.sock", "/etc",
      "/home", "/root", "/opt/trader20-v3", "/var/lib/trader20-v3"
    ]
  }
}
