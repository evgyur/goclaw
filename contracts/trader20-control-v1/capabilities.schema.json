{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trader20.local/contracts/trader20-control-v1/capabilities.schema.json",
  "title": "trader20.control.v1 capabilities envelope",
  "allOf": [
    {"$ref": "read-envelope.schema.json"},
    {
      "properties": {
        "operation": {"const": "capabilities"},
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operations", "provider_endpoint", "control_endpoint_configured", "write_capabilities", "signing_available", "account_configured"],
          "properties": {
            "operations": {
              "type": "array",
              "prefixItems": [
                {"const": "capabilities"}, {"const": "status"}, {"const": "positions"},
                {"const": "orders"}, {"const": "history"}, {"const": "explain_blocker"},
                {"const": "runtime_health"}, {"const": "pause_entries"}, {"const": "resume_entries"},
                {"const": "latch_kill"}, {"const": "cancel_pending_plan"},
                {"const": "plan_trade"}, {"const": "execute_plan"}
              ],
              "items": false,
              "minItems": 13,
              "maxItems": 13
            },
            "provider_endpoint": {"const": "/info"},
            "control_endpoint_configured": {"type": "boolean"},
            "write_capabilities": {
              "type": "array",
              "prefixItems": [{"const": "plan_trade"}, {"const": "execute_plan"}],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            "signing_available": {"const": false},
            "account_configured": {"type": "boolean"},
            "operational_controls": {"type": "array", "items": {"enum": ["pause_entries", "resume_entries", "latch_kill", "cancel_pending_plan"]}, "uniqueItems": true},
            "money_controls": {"type": "array", "prefixItems": [{"const": "execute_plan"}, {"const": "plan_trade"}], "items": false, "minItems": 2, "maxItems": 2},
            "money_control_available": {"type": "boolean"},
            "money_control_blocker": {"type": "string"},
            "single_writer": {"const": "trader20-v3"},
            "raw_exchange_credentials": {"const": false},
            "direct_exchange_write": {"const": false}
          }
        }
      }
    }
  ]
}
