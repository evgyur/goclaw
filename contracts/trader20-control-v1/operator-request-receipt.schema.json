{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trader20.local/contracts/trader20-control-v1/operator-request-receipt.schema.json",
  "title": "Fresh candidate-bound authenticated operator request receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "receipt_hash", "purpose", "binding_hash", "authority_hash", "account_fingerprint", "principal", "client_id", "request_origin", "owner_sender_id_hash", "authority_nonce", "authority_expires_at_ms", "candidate_commit", "candidate_tree", "policy_hash", "nonce", "expires_at_ms", "max_execution_intents", "max_gross_notional_usdc", "execution_max_slippage_bps", "authenticated_human", "signature_algorithm", "signing_key_id", "signature"],
  "properties": {
    "schema": {"const": "trader20.control.operator-request-receipt.v1"},
    "receipt_hash": {"$ref": "types.schema.json#/$defs/sha256"},
    "purpose": {"enum": ["PLAN", "EXECUTE"]},
    "binding_hash": {"$ref": "types.schema.json#/$defs/sha256"},
    "authority_hash": {"$ref": "types.schema.json#/$defs/sha256"},
    "account_fingerprint": {"$ref": "types.schema.json#/$defs/sha256"},
    "principal": {"$ref": "types.schema.json#/$defs/identifier"},
    "client_id": {"$ref": "types.schema.json#/$defs/identifier"},
    "request_origin": {"$ref": "types.schema.json#/$defs/identifier"},
    "owner_sender_id_hash": {"$ref": "types.schema.json#/$defs/sha256"},
    "authority_nonce": {"$ref": "types.schema.json#/$defs/identifier"},
    "authority_expires_at_ms": {"type": "integer", "minimum": 1},
    "candidate_commit": {"$ref": "types.schema.json#/$defs/commit"},
    "candidate_tree": {"$ref": "types.schema.json#/$defs/commit"},
    "policy_hash": {"$ref": "types.schema.json#/$defs/sha256"},
    "nonce": {"$ref": "types.schema.json#/$defs/identifier"},
    "expires_at_ms": {"type": "integer", "minimum": 1},
    "max_execution_intents": {"type": "integer", "minimum": 1, "maximum": 1000},
    "max_gross_notional_usdc": {"$ref": "types.schema.json#/$defs/positiveDecimal"},
    "execution_max_slippage_bps": {"oneOf": [{"const": "5"}, {"const": 5}]},
    "authenticated_human": {"const": true},
    "signature_algorithm": {"const": "Ed25519"},
    "signing_key_id": {"$ref": "types.schema.json#/$defs/identifier"},
    "signature": {"type": "string", "minLength": 16, "maxLength": 256}
  }
}
